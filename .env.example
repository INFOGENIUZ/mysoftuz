# -----------------------------------------------------------------------------
# TELEGRAM SOFTWARE STORE BOT — ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Telegram Bot Token (@BotFather dan olingan tokeningizni yozing)
BOT_TOKEN=8973630874:AAH3uXz8PvwOSOTrz4ISykWgqWtRPstHE-w

# Admin Telegram ID si (@userinfobot dan olingan ID ingizni yozing)
ADMIN_IDS=8887751785
ADMINS=8887751785

# Environment & Application Version
ENVIRONMENT=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Database Configuration (SQLite WAL Mode)
DATABASE_URL=sqlite+aiosqlite:///data/software_bot.db
DB_NAME=software_bot.db
DB_BUSY_TIMEOUT=5000

# Timezone
TIMEZONE=Asia/Tashkent

# Limits & Pagination
SEARCH_MAX_RESULTS=100
SEARCH_PAGE_SIZE=10
PROGRAMS_PER_PAGE=10
CATEGORIES_PER_PAGE=10

# Monetization & Feature Flags
MONETIZATION_ENABLED=true
PREMIUM_ENABLED=true
PAID_PROGRAMS_ENABLED=true
PROMO_ENABLED=true
PAYMENT_PROVIDER=SANDBOX
PAYMENT_CURRENCY=UZS

# Worker & Caching
ANALYTICS_CACHE_TTL=60
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_RETRIES=3
WORKER_POLL_INTERVAL=1
FSM_TTL_MINUTES=30

# Performance Monitoring
SLOW_QUERY_THRESHOLD_MS=300
SLOW_HANDLER_THRESHOLD_MS=1000
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
