# -----------------------------------------------------------------------------
# TELEGRAM SOFTWARE STORE BOT — PRODUCTION ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Application Version & Environment Mode
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Telegram Bot Credentials
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Administrator Telegram User IDs (Comma-separated)
ADMIN_IDS=123456789,987654321

# Database Configuration (SQLite WAL mode)
DATABASE_URL=sqlite+aiosqlite:///data/software_store.db
DB_BUSY_TIMEOUT=5000

# Timezone Setting
TIMEZONE=Asia/Tashkent

# Search & Pagination Limits
SEARCH_MAX_RESULTS=100
SEARCH_PAGE_SIZE=10

# Caching & Worker Configuration
ANALYTICS_CACHE_TTL=60
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_RETRIES=3
WORKER_POLL_INTERVAL=1
FSM_TTL_MINUTES=30

# Observability & Monitoring Thresholds
SLOW_QUERY_THRESHOLD_MS=300
SLOW_HANDLER_THRESHOLD_MS=1000
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
